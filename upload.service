[Unit]
Description=Video uploader
After=network.target

[Service]
TimeoutStopSec=3s
RestartSec=20
ExecStart=/home/manager/turnstile_controller/venv/bin/python /home/manager/turnstile_controller/camera/upload_to_s3.py
User=manager
Restart=always
WorkingDirectory=/home/manager/turnstile_controller/


[Install]
WantedBy=multi-user.target