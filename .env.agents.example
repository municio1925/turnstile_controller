# Plantilla de credenciales para agentes de depuración.
# Copia este fichero a `.env.agents` (gitignored) y rellénalo con los valores
# reales del fichero de contraseñas. NO pongas valores reales aquí: este fichero
# .example SÍ se sube al repo (público).

# --- Dispositivos ODROID / Raspberry (puertas, tornos, cámaras) ---
DEVICE_SSH_PASSWORD='<del fichero de contraseñas>'
DEVICE_SSH_USER='manager'            # algunos ODROID usan root
DEVICE_SSH_HOST='<host del relay FRP>'   # el puerto (-p) es por dispositivo (sale en el frontend)

# --- Servidores remotos: por si hay que depurar el turnstile junto con el
#     backend o el frontend ---
INFRASTRUCTURE_SSH_PASSWORD='<del fichero de contraseñas>'
BACKEND_SSH='<usuario>@<host-backend>'
FRONTEND_SSH='<usuario>@<host-frontend>'
FRP_JUMPHOST_SSH='<usuario>@<host-frp>'

# --- Base de datos de producción (Postgres) — para identificar gimnasio/dispositivo ---
POSTGRES_DB_HOST='<host-backend>'
POSTGRES_DB_PORT='<puerto>'
POSTGRES_DB_USER='<usuario>'
POSTGRES_DB_NAME='<nombre-bd>'
POSTGRES_DB_PASSWORD='<del fichero de contraseñas>'
